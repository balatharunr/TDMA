<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE transport SYSTEM "file:///usr/share/emane/dtd/transport.dtd">
<!-- Division 5: the virtual transport creates the TUN device "emane0" (address/mask/device come from the platform XML).
     CONCEPT: TUN device emane0 - IP packets written to emane0 by ping become emulated radio frames. -->
<transport library="transvirtual">
  <param name="bitrate"    value="0"/>
  <param name="devicepath" value="/dev/net/tun"/>
</transport>
